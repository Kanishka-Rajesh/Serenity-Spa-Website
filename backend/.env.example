# Serenity Spa Backend Environment Configuration
# Copy this file to .env or set these environment variables in your environment

# Server
SERVER_PORT=8080

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/serenity_spa?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Security / JWT
JWT_SECRET=SerenitySpaSuperSecretKeyThatMustBeAtLeast256BitsLongForHMACSHA256Security123456
JWT_EXPIRATION_MS=86400000

# Spring Active Profile (use 'mysql' or 'h2')
SPRING_PROFILES_ACTIVE=mysql
